# Plantilla de configuración local — Sistema de Gestión Odontológica.
#
# Uso: copiar este archivo como `.env` en la raíz del proyecto y completar
# los valores locales. `.env` está en .gitignore y NUNCA se sube al repo
# (regla dura 5). Este archivo va SIEMPRE sin valores.

# Cadena de conexión de la API, el runner de migraciones y el bootstrap; debe apuntar a
# la base definida por POSTGRES_* de más abajo (local: puerto 5432).
DATABASE_URL=

# Credenciales del primer administrador; solo las usa el comando interno
# crear-consultorio. Proveerlas por el entorno privado del operador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Secreto para firmar y verificar los JWT (HS256). DEBE tener al menos 32
# caracteres: si falta, está vacío o tiene menos de 32 caracteres (mínimo 32),
# la API NO arranca (fail-fast, sin secreto por defecto). Esta plantilla va
# SIEMPRE sin valores (regla dura 5): dejá la línea vacía acá y completá tu
# secreto SOLO en .env. Para generar uno nuevo de ≥32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Variables que consume compose.yaml por sustitución para inicializar
# PostgreSQL 18 (no llevan valores en este template).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
